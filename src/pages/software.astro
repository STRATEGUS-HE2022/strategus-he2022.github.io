---
/**
 * Software: one section per record, in `order`. Each section has the record's slug as its
 * id, which is where the home page and news items point. Related papers are pulled from
 * the bibliography by BibTeX key, so the page follows publications.bib.
 */
import { render } from 'astro:content';
import { site } from '../data/site.ts';
import PageLayout from '../layouts/PageLayout.astro';
import { getPeople, getPublicationsForSoftware, getSoftware } from '../lib/content.ts';
import { formatAuthors, formatVenueLine } from '../lib/publications.ts';

const people = await getPeople();
const software = await getSoftware();
const byId = new Map(software.map((s) => [s.id, s]));
const items = await Promise.all(
  software.map(async (item) => {
    const d = item.data;
    const { Content } = await render(item);
    const links = [
      d.website && { label: 'Website', href: d.website },
      { label: d.repository.includes('/', 'https://github.com/'.length) ? 'Repository' : 'GitHub organisation', href: d.repository },
      d.documentation && { label: 'Documentation', href: d.documentation },
    ].filter((x): x is { label: string; href: string } => Boolean(x));
    const team = d.people.map((ref) => people.find((p) => p.id === ref.id)).filter((p) => p !== undefined);
    return { item, Content, links, team, parent: d.partOf ? byId.get(d.partOf.id) : undefined, publications: await getPublicationsForSoftware(item) };
  }),
);
---

<PageLayout
  title="Software"
  eyebrow={site.shortName}
  lede="Open-source tools born in the project and the ecosystem that carries them forward. Everything here is public, under BSD licences, and open to contributions."
  description={`Open-source software of ${site.shortName}: the GLACIER ecosystem, the Frost simulation platform and the FlexMan scheduling library.`}
>
  {items.map(({ item, Content, links, team, parent, publications }) => (
    <section class="tool section" id={item.id} aria-labelledby={`tool-${item.id}`}>
      <div class="tool__margin">
        <p class="tool__kind">{item.data.kind}</p>
        {parent && <p class="meta">Part of <a href={`#${parent.id}`}>{parent.data.name}</a></p>}
        <dl class="tool__facts">
          <div><dt>Licence</dt><dd>{item.data.licence}</dd></div>
          {item.data.languages.length > 0 && <div><dt>Written in</dt><dd>{item.data.languages.join(', ')}</dd></div>}
        </dl>
      </div>
      <div class="tool__body">
        <h2 id={`tool-${item.id}`} class="tool__name">{item.data.name}</h2>
        <p class="tool__summary">{item.data.summary}</p>
        <div class="prose">
          <Content />
        </div>
        <ul class="tool__links" aria-label={`Links for ${item.data.name}`}>
          {links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
        {publications.length > 0 && (
          <div class="tool__papers">
            <h3 class="tool__subheading">Papers</h3>
            <ul class="papers">
              {publications.map((p) => (
                <li class="paper">
                  <a href={p.doi ? `https://doi.org/${p.doi}` : p.url}>{p.title}</a>
                  <p class="meta">{[formatAuthors(p.authors).replace(/\.$/, ''), formatVenueLine(p)].filter(Boolean).join('. ')}.</p>
                </li>
              ))}
            </ul>
          </div>
        )}
        {team.length > 0 && (
          <p class="meta tool__team">
            Team: {team.map((p, i) => (<>{i > 0 && ', '}<a href={`/team/#${p.id}`}>{p.data.name}</a></>))}
          </p>
        )}
      </div>
    </section>
  ))}
</PageLayout>

<style>
  .tool {
    display: grid;
    grid-template-columns: minmax(8rem, 11rem) 1fr;
    gap: var(--space-md) var(--space-xl);
    /* Anchored from the home page and from news: leave room for the masthead when jumping. */
    scroll-margin-top: var(--space-lg);
  }

  .tool__margin {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .tool__kind {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .tool__facts {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
  }

  .tool__facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .tool__body {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }

  .tool__name {
    font-size: var(--text-2xl);
  }

  .tool__summary {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    max-width: var(--measure);
  }

  .tool__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tool__links a {
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .tool__links a:hover {
    border-bottom-color: var(--color-accent);
  }

  .tool__papers {
    margin-top: var(--space-sm);
  }

  .tool__subheading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: var(--space-xs);
  }

  .papers {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }

  .paper > a {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    text-decoration: none;
  }

  .paper > a:hover {
    text-decoration: underline;
  }

  .tool__team {
    margin-top: var(--space-xs);
  }

  @media (max-width: 40rem) {
    .tool {
      grid-template-columns: 1fr;
    }
  }
</style>
