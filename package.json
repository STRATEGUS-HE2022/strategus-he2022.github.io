{
  "name": "strategus-he2022.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static website of STRATEGUS (STRATEgic GUide to Smart manufacturing), a Marie Skłodowska-Curie Global Fellowship at the University of Verona and UNC Chapel Hill",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
